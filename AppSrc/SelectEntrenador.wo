Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebColumnButton.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg

Use cEntrenadorDataDictionary.dd

Register_Object oZoomEntrenador

Object oSelectEntrenador is a cWebView
    Set peWebViewStyle to wvsDrillDown
    Set peViewType to vtSelect
    Set psCaption to "Entrenadores"
    Set psStateViewName to "Entrenadores"
    Set piMaxWidth to 1024
    Set piColumnCount to 6
    Set peLayoutType to ltGrid

    WebSetResponsive piColumnCount rmTabletPortrait to 3

    Object oEntrenador_DD is a cEntrenadorDataDictionary
    End_Object

    Set Main_DD to oEntrenador_DD
    Set Server to oEntrenador_DD

    Object oWebMainPanel is a cWebPanel
        Set psRowHeights to "0/1fr"
        Set piRowCount to 1

        Object oList is a cWebList
            Set pbFillHeight to True
            Set piColumnSpan to 0
            Set pbServerOnRowClick to True
            Set psCSSClass to "MobileList"
            Set piSortColumn to 0
            Set pbShowHeader to False

            WebRegisterPath ntNavigateForward oZoomEntrenador Self "EditEntrenador"

            Object oNombre is a cWebColumn
                Entry_Item entrenador.Nombre
                Set psCaption to "Nombre"
                Set psCSSClass to "RowCaption"
                Set peAlign to alignLeft
                Set piWidth to 220
                Set piListColSpan to 2
            End_Object

            Object oDetailButton is a cWebColumnButton
                Set piWidth to 45
                Set pbFixedWidth to True
                Set psCaption to "btn"
                Set pbResizable to False
                Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
                Set peAlign to alignRight
                Set piListRowSpan to 2

                WebRegisterPath ntNavigateForward oZoomEntrenador Self "EditEntrenadorButton"

                Procedure OnClick String sButton String sRowId
                    Send NavigateForward of oZoomEntrenador Self
                End_Procedure
            End_Object

            Object oApellido is a cWebColumn
                Entry_Item entrenador.Apellido
                Set psCaption to "Apellido"
                Set psCSSClass to "RowDetail"
                Set pbNewLine to True
                Set piWidth to 220
            End_Object

            Object oNacionalidad is a cWebColumn
                Entry_Item entrenador.Nacionalidad
                Set psCaption to "Nacionalidad"
                Set psCSSClass to "RowDetail"
                Set piWidth to 160
            End_Object

            Procedure OnRowClick String sRowID
                Send NavigateForward of oZoomEntrenador Self
            End_Procedure
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup
        Set psGroupName to "MainActions"

        Object oSearch is a cWebMenuItem
            Set psCaption to "Buscar"
            Set psCSSClass to "WebPromptMenuItem"

            Procedure OnClick
                Send Search of oList
            End_Procedure
        End_Object

        Object oNewButton is a cWebMenuItem
            Set psCaption to "Nuevo"
            Set psCSSClass to "WebClearMenuItem"

            WebRegisterPath ntNavigateForward oZoomEntrenador Self "NewEntrenador"

            Procedure OnClick
                Send NavigateForward of oZoomEntrenador Self
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure
        End_Object

        Object oFindTop is a cWebMenuItem
            Set psCaption to "Inicio"
            Set peActionDisplay to adMenu
            Set pbBeginGroup to True

            Procedure OnClick
                Send MoveToFirstRow of oList
            End_Procedure
        End_Object

        Object oFindLast is a cWebMenuItem
            Set psCaption to "Final"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send MoveToLastRow of oList
            End_Procedure
        End_Object
    End_Object

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        Send SetBreadcrumbCaption "Entrenadores"
        Send SetHeaderCaption "Entrenadores"
    End_Procedure
End_Object

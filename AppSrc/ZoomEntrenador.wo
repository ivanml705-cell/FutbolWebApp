Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg

Use cEntrenadorDataDictionary.dd

Object oZoomEntrenador is a cWebView
    Set peWebViewStyle to wvsDrillDown
    Set peViewType to vtZoom
    Set psCaption to "Entrenador"
    Set psStateViewName to "Entrenador"
    Set pbShowCaption to False
    Set Verify_Save_msg to 0
    Set piMaxWidth to 720
    Set piColumnCount to 12
    Set peLayoutType to ltGrid

    Object oEntrenador_DD is a cEntrenadorDataDictionary
    End_Object

    Set Main_DD to oEntrenador_DD
    Set Server to oEntrenador_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 6

        Object oID is a cWebForm
            Entry_Item entrenador.ID
            Set psLabel to "ID"
            Set psPlaceHolder to "Nuevo"
            Set piColumnSpan to 0
            Set piLabelOffset to 110
            Set pbEnabled to False

            WebSetResponsive peLabelPosition rmMobile to lpTop
            WebSetResponsive piLabelOffset rmMobile to 0
        End_Object

        Object oNombre is a cWebForm
            Entry_Item entrenador.Nombre
            Set psLabel to "Nombre"
            Set piColumnSpan to 0
            Set piLabelOffset to 110

            WebSetResponsive peLabelPosition rmMobile to lpTop
            WebSetResponsive piLabelOffset rmMobile to 0
        End_Object

        Object oApellido is a cWebForm
            Entry_Item entrenador.Apellido
            Set psLabel to "Apellido"
            Set piColumnSpan to 0
            Set piLabelOffset to 110

            WebSetResponsive peLabelPosition rmMobile to lpTop
            WebSetResponsive piLabelOffset rmMobile to 0
        End_Object

        Object oNacionalidad is a cWebForm
            Entry_Item entrenador.Nacionalidad
            Set psLabel to "Nacionalidad"
            Set piColumnSpan to 0
            Set piLabelOffset to 110

            WebSetResponsive peLabelPosition rmMobile to lpTop
            WebSetResponsive piLabelOffset rmMobile to 0
        End_Object

        Object oEquipoID is a cWebForm
            Entry_Item entrenador.EquipoID
            Set psLabel to "Equipo ID"
            Set piColumnSpan to 0
            Set piLabelOffset to 110

            WebSetResponsive peLabelPosition rmMobile to lpTop
            WebSetResponsive piLabelOffset rmMobile to 0
        End_Object

        Object oButtonPanel is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 0
            Set pbShowBorder to False
            Set pbShowCaption to False

            Object oGuardar is a cWebButton
                Set psCaption to "Guardar"
                Set piColumnSpan to 3

                Procedure OnClick
                    Send Request_Save
                End_Procedure
            End_Object

            Object oNuevo is a cWebButton
                Set psCaption to "Nuevo"
                Set piColumnSpan to 3

                Procedure OnClick
                    Send Request_Clear
                End_Procedure
            End_Object
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup
        Set psGroupName to "MainActions"

        Object oSaveBtn is a cWebMenuItem
            Set psCaption to "Guardar"
            Set psCSSClass to "WebSaveMenuItem"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oNewBtn is a cWebMenuItem
            Set psCaption to "Nuevo"
            Set psCSSClass to "WebClearMenuItem"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Clear
            End_Procedure
        End_Object
    End_Object

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        If (NavigateData.bNewRecord) Begin
            Send SetBreadcrumbCaption "Nuevo entrenador"
        End
        Else Begin
            Send SetBreadcrumbCaption "Editar entrenador"
        End

        Send SetHeaderCaption "Entrenador"
    End_Procedure
End_Object
